// List 3-1  「クリックすると一定の速さで回転する」スクリプト 

using UnityEngine;

public class RouletteController : MonoBehaviour
{
    float rotSpeed = 0; // 回転速度

    void Start()
    {
        // フレームレートを60に固定する
	        Application.targetFrameRate = 60;
    }

    void Update()
    {
        // マウスが押されたら回転速度を設定する
        if ( Input.GetMouseButtonDown(0))
        {
            this.rotSpeed = 10;
        }

        // 回転速度ぶん、ルーレットを回転させる
        transform.Rotate(0, 0, this.rotSpeed);
    }
}
